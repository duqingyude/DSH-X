{
  "name": "dsh-x",
  "productName": "DSH",
  "version": "0.1.24",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 桌面启动器：Rust 原生外壳 + 浏览器界面，负责启动项与多实例、版本、插件、整合包、MCP 和技能管理。",
  "main": "start.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node start.js",
    "server": "node server.js",
    "shell": "cargo run --release --manifest-path shell-rs/Cargo.toml",
    "test": "node --test",
    "dist": "node scripts/pack-rs.mjs",
    "release:manifest": "node scripts/release-manifest.mjs make",
    "release:sbom": "node scripts/release-sbom.mjs",
    "release:verify": "node scripts/release-manifest.mjs verify",
    "release:check": "node scripts/release-manifest.mjs check-tag"
  },
  "author": "duqingyude",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duqingyude/DSH-X.git"
  },
  "homepage": "https://duqingyude.github.io/DSH-X/",
  "bugs": {
    "url": "https://github.com/duqingyude/DSH-X/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "launcher"
  ]
}
